<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:LogStream.Maui.ViewModels"
    x:Class="LogStream.Maui.Views.SettingsPopup"
    xmlns:local="clr-namespace:LogStream.Maui.Views"
    x:DataType="vm:SettingsViewModel"
    BackgroundColor="Transparent"
    WidthRequest="400"
    HeightRequest="450">


    <Border x:Name="PopupBorder"
            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}"
            Stroke="Transparent"
            StrokeThickness="0"
            Padding="0">
        <VerticalStackLayout Padding="24" Spacing="20">
            <Label Text="Settings" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="Theme" FontSize="16" FontAttributes="Bold" />
            <RadioButton Content="System" IsChecked="{Binding IsSystem}" />
            <RadioButton Content="Light" IsChecked="{Binding IsLight}" />
            <RadioButton Content="Dark" IsChecked="{Binding IsDark}" />
            <Button Text="Close" Command="{Binding CloseCommand}" />
            <Label Text="{Binding AppVersion, StringFormat='Version: {0}'}" FontSize="12" HorizontalOptions="Center" />
        </VerticalStackLayout>

    </Border>

</toolkit:Popup>
